# Copy this file to android/keystore.properties (gitignored) for local signed Play Store builds.
# Generate your upload keystore once with:
#   keytool -genkey -v -keystore crownward-upload.jks -keyalg RSA -keysize 2048 -validity 10000 -alias crownward
storeFile=../crownward-upload.jks
storePassword=CHANGE_ME_STORE_PASSWORD
keyAlias=crownward
keyPassword=CHANGE_ME_KEY_PASSWORD
